# Password for /admin — set this before signing in
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie (e.g. openssl rand -base64 32)
SESSION_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Needed for saving from /admin and uploading photos. Dashboard → Project Settings →
# API Keys → Secret keys (sb_secret_…). Server-only: never share or commit it.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=media
